            /// 
            nack = 1,
        }
        /// [0:0] `
        pub iack: u1;
        /// [1:2] 
        pub res0: u2;
        /// [3:3] When a receiver, sent ACK (0) or NACK (1)
        pub ack: i2c0.Cr.Ack;
        /// [4:4] Write to slave
        pub wr: u1;
        /// [5:5] Read from slave
        pub rd: u1;
        /// [6:6] Generate stop condition
        pub sto: u1;
