        /// [16:19] 
        pub length: u4;
        /// [20:31] 
        pub res1: u12;
    }
    pub const fmt: mmio.Reg32<qspi2.Fmt> = { addr: 0x10034040 };

    /// Transmit Data Register
    pub packed struct Txdata {
        /// [0:7] 
        pub data: u8;
        /// [8:30] 
        pub res0: u23;
        /// [31:31] 
        pub full: u1;
    }
    pub const txdata: mmio.Reg32<qspi2.Txdata> = { addr: 0x10034048 };

    /// Receive Data Register
    pub packed struct Rxdata {
        /// [0:7] 
        pub data: u8;
        /// [8:30] 
        pub res0: u23;
        /// [31:31] 
        pub empty: u1;
    }
    pub const rxdata: mmio.Reg32<qspi2.Rxdata> = { addr: 0x1003404c };

    /// Transmit Watermark Register
    pub packed struct Txmark {
        /// [0:2] 
        pub value: u3;
        /// [3:31] 
        pub res0: u29;
    }
    pub const txmark: mmio.Reg32<qspi2.Txmark> = { addr: 0x10034050 };

    /// Receive Watermark Register
    pub packed struct Rxmark {
        /// [0:2] 
        pub value: u3;
        /// [3:31] 
        pub res0: u29;
    }
    pub const rxmark: mmio.Reg32<qspi2.Rxmark> = { addr: 0x10034054 };

    /// SPI Flash Interface Control Register
    pub packed struct Fctrl {
        /// [0:0] 
        pub enable: u1;
        /// [1:31] 
        pub res0: u31;
    }
    pub const fctrl: mmio.Reg32<qspi2.Fctrl> = { addr: 0x10034060 };

    /// SPI Flash Instruction Format Register
    pub packed struct Ffmt {
        /// Values for cmd_proto
        pub enum CmdProto: u2 {
            /// DQ0 (MOSI), DQ1 (MISO)
            single = 0,
            /// DQ0, DQ1
            dual = 1,
            /// DQ0, DQ1, DQ2, DQ3
            quad = 2,
            /// Reserved value
            reserved_3 = 3,
        }
        /// Values for addr_proto
        pub enum AddrProto: u2 {
            /// DQ0 (MOSI), DQ1 (MISO)
            single = 0,
            /// DQ0, DQ1
            dual = 1,
            /// DQ0, DQ1, DQ2, DQ3
            quad = 2,
            /// Reserved value
            reserved_3 = 3,
        }
        /// Values for data_proto
        pub enum DataProto: u2 {
            /// DQ0 (MOSI), DQ1 (MISO)
            single = 0,
            /// DQ0, DQ1
            dual = 1,
            /// DQ0, DQ1, DQ2, DQ3
            quad = 2,
            /// Reserved value
            reserved_3 = 3,
        }
        /// [0:0] 
        pub res0: u1;
        /// [1:3] Number of address bytes (0 to 4)
        pub addr_len: u3;
        /// [4:7] 
        pub res1: u4;
        /// [8:9] Protocol for transmitting command
        pub cmd_proto: qspi2.Ffmt.CmdProto;
        /// [10:11] Protocol for transmitting address and padding
        pub addr_proto: qspi2.Ffmt.AddrProto;
        /// [12:13] Protocol for receiving data bytes
        pub data_proto: qspi2.Ffmt.DataProto;
        /// [14:15] 
        pub res2: u2;
        /// [16:23] Value of command byte
        pub cmd_code: u8;
        /// [24:31] First 8 bits to transmit during dummy cycles
        pub pad_code: u8;
    }
    pub const ffmt: mmio.Reg32<qspi2.Ffmt> = { addr: 0x10034064 };

    /// SPI Interrupt Enable Register
    pub packed struct Ie {
        /// [0:0] 
        pub txwm: u1;
        /// [1:1] 
        pub rxwm: u1;
        /// [2:31] 
        pub res0: u30;
    }
    pub const ie: mmio.Reg32<qspi2.Ie> = { addr: 0x10034070 };

    /// SPI Interrupt Pending Register
    pub packed struct Ip {
        /// [0:0] 
        pub txwm: u1;
        /// [1:1] 
        pub rxwm: u1;
        /// [2:31] 
        pub res0: u30;
    }
    pub const ip: mmio.Reg32<qspi2.Ip> = { addr: 0x10034074 };

}


/// 8-bit timer with 4 cmp
pub struct pwm2 {
    /// PWM Configuration Register
    pub packed struct Cfg {
        /// [0:3] 
        pub scale: u4;
        /// [4:7] 
        pub res0: u4;
        /// [8:8] 
        pub sticky: u1;
        /// [9:9] 
        pub zerocmp: u1;
        /// [10:10] 
        pub deglitch: u1;
        /// [11:11] 
        pub res1: u1;
        /// [12:12] 
        pub enalways: u1;
        /// [13:13] 
        pub enoneshot: u1;
        /// [14:15] 
        pub res2: u2;
        /// [16:16] 
        pub cmp0center: u1;
        /// [17:17] 
        pub cmp1center: u1;
        /// [18:18] 
        pub cmp2center: u1;
        /// [19:19] 
        pub cmp3center: u1;
        /// [20:23] 
        pub res3: u4;
        /// [24:24] 
        pub cmp0gang: u1;
        /// [25:25] 
        pub cmp1gang: u1;
        /// [26:26] 
        pub res4: u1;
        /// [27:27] 
        pub cmp3gang: u1;
        /// [28:28] 
        pub cmp0ip: u1;
        /// [29:29] 
        pub cmp1ip: u1;
        /// [30:30] 
        pub cmp2ip: u1;
        /// [31:31] 
        pub cmp3ip: u1;
    }
    pub const cfg: mmio.Reg32<pwm2.Cfg> = { addr: 0x10035000 };

    /// Counter Register
    pub packed struct Count {
        /// [0:31] 
        pub raw: u32;
    }
    pub const count: mmio.Reg32<pwm2.Count> = { addr: 0x10035008 };

    /// Scaled Halfword Counter Register
    pub packed struct Pwms {
        /// [0:31] 
        pub raw: u32;
    }
    pub const pwms: mmio.Reg32<pwm2.Pwms> = { addr: 0x10035010 };

    /// Compare Register
    pub packed struct Cmp0 {
        /// [0:15] 
        pub value: u16;
        /// [16:31] 
        pub res0: u16;
    }
    pub const cmp0: mmio.Reg32<pwm2.Cmp0> = { addr: 0x10035020 };

    /// Compare Register
    pub packed struct Cmp1 {
        /// [0:15] 
        pub value: u16;
        /// [16:31] 
        pub res0: u16;
    }
    pub const cmp1: mmio.Reg32<pwm2.Cmp1> = { addr: 0x10035024 };

    /// Compare Register
    pub packed struct Cmp2 {
        /// [0:15] 
        pub value: u16;
        /// [16:31] 
        pub res0: u16;
    }
    pub const cmp2: mmio.Reg32<pwm2.Cmp2> = { addr: 0x10035028 };

    /// Compare Register
    pub packed struct Cmp3 {
        /// [0:15] 
        pub value: u16;
        /// [16:31] 
        pub res0: u16;
    }
    pub const cmp3: mmio.Reg32<pwm2.Cmp3> = { addr: 0x1003502c };

}
