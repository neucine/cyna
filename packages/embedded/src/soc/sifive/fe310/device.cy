    /// Delay Control 0 Register
    pub packed struct Delay0 {
        /// [0:7] 
        pub cssck: u8;
        /// [8:15] 
        pub res0: u8;
        /// [16:23] 
        pub sckcs: u8;
        /// [24:31] 
        pub res1: u8;
    }
