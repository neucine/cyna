            /// DQ0 (MOSI), DQ1 (MISO)
            single = 0,
            /// DQ0, DQ1
            dual = 1,
            /// DQ0, DQ1, DQ2, DQ3
            quad = 2,
            /// Reserved value
            reserved_3 = 3,
        }
        /// Values for endian
        pub enum Endian: u1 {
            /// Transmit MSB first.
            big = 0,
            /// Transmit LSB first.
            little = 1,
        }
        /// Values for direction
        pub enum Direction: u1 {
            /// For dual and quad protocols, the DQ pins are tri-stated. For the single protocol, the DQ0 pin is driven with the transmit data as normal.
            rx = 0,
            /// The receive FIFO is not populated.
            tx = 1,
        }
        /// [0:1] 
        pub `protocol`: qspi0.Fmt.Protocol;
        /// [2:2] 
        pub endian: qspi0.Fmt.Endian;
        /// [3:3] 
        pub direction: qspi0.Fmt.Direction;
        /// [4:15] 
        pub res0: u12;
        /// [16:19] 
        pub length: u4;
        /// [20:31] 
        pub res1: u12;
    }
